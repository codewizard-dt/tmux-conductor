# =============================================================================
# tmux-conductor environment configuration (example)
# Copy to .env and fill in. Everything runs locally — no secrets required.
#
# `make` only exports BACKEND_PORT, FRONTEND_PORT, PROXY_TARGET, VITE_API_URL,
# FASTIFY_STRUCTURED_LOGS, and FASTIFY_LOG_LEVEL to child processes (make dev's
# children). `-include .env` loads any extra keys you add to your local .env,
# but they are NOT exported to make dev's children unless you also add them to
# the Makefile's explicit `export` line.
# =============================================================================

# -----------------------------------------------------------------------------
# host-server (native tmux conductor)
# -----------------------------------------------------------------------------
# Fastify listen port for the native conductor host-server. Default 8788.
BACKEND_PORT=8788

# Enable Fastify's structured request logger. Default off for quieter local dev.
FASTIFY_STRUCTURED_LOGS=0
FASTIFY_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# frontend (Vite dashboard)
# -----------------------------------------------------------------------------
# Vite dev server port. Default 4321.
FRONTEND_PORT=4321

# Vite dev proxy target for /api/* (the host-server). Default http://127.0.0.1:${BACKEND_PORT:-8788}.
PROXY_TARGET=http://127.0.0.1:8788

# Frontend API base override (frontend/src/lib/api.ts).
# Falls back to /api via the Vite proxy when unset.
VITE_API_URL=
