# =============================================================================
# tmux-conductor environment configuration (example)
# Copy to .env and fill in. Everything runs locally — no secrets required.
# =============================================================================

# -----------------------------------------------------------------------------
# host-server (native tmux conductor)
# -----------------------------------------------------------------------------
# Fastify listen port for the native conductor host-server. Default 8788.
BACKEND_PORT=8788

# -----------------------------------------------------------------------------
# frontend (Vite dashboard)
# -----------------------------------------------------------------------------
# Vite dev server port. Default 4321.
FRONTEND_PORT=4321

# Vite dev proxy target for /api/* (the host-server). Default http://localhost:${BACKEND_PORT:-8788}.
PROXY_TARGET=http://localhost:8788

# Frontend API base override (frontend/src/lib/api.ts).
# Falls back to /api via the Vite proxy when unset.
VITE_API_URL=
